@{
    ViewData["Title"] = "WebRTC 1-to-Many Test";
}

<h2>1-to-Many WebRTC Test</h2>

<div>

    <label>Lecture ID:</label>

    <input type="number"
           id="lectureId"
           value="101" />

    <button id="joinButton">
        Join Lecture
    </button>

    <button id="leaveButton" disabled>
        Leave Meeting
    </button>

</div>

<hr />

<h4>My Video</h4>

<video id="localVideo"
       autoplay
       muted
       playsinline
       width="400">
</video>

<hr />

<h4>Students / Remote Videos</h4>

<div id="remoteVideos">
    <!-- Remote videos will be created here -->
</div>

<p id="status">
    Not connected
</p>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>


<script>

    // =========================================================
    // 1. HTML ELEMENTS
    // =========================================================

    const localVideo =
        document.getElementById("localVideo");

    const remoteVideos =
        document.getElementById("remoteVideos");

    const joinButton =
        document.getElementById("joinButton");

    const leaveButton =
        document.getElementById("leaveButton");

    const status =
        document.getElementById("status");


    // =========================================================
    // 2. SIGNALR CONNECTION
    // =========================================================

    const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/lectureHub")
            .build();


    // =========================================================
    // 3. WEBRTC CONNECTIONS
    // =========================================================

    /*
        1-to-1:

            let peerConnection;

        1-to-many:

            One PeerConnection for EACH student.
    */

    const peerConnections = {};


    // =========================================================
    // 4. LOCAL STREAM
    // =========================================================

    let localStream = null;


    // =========================================================
    // 5. START CAMERA AND MICROPHONE
    // =========================================================

    async function startCamera()
    {
        localStream =
            await navigator.mediaDevices
                .getUserMedia({
                    video: true,
                    audio: true
                });

        localVideo.srcObject =
            localStream;
    }


    // =========================================================
    // 6. CREATE PEER CONNECTION
    // =========================================================

    function createPeerConnection(connectionId)
    {
        console.log(
            "Creating PeerConnection for:",
            connectionId
        );


        const peerConnection =
            new RTCPeerConnection({

                iceServers: [
                    {
                        urls:
                            "stun:stun.l.google.com:19302"
                    }
                ]

            });


        // -----------------------------------------------------
        // Add my camera + microphone to THIS student connection
        // -----------------------------------------------------

        localStream
            .getTracks()
            .forEach(track => {

                peerConnection.addTrack(
                    track,
                    localStream
                );

            });


        // -----------------------------------------------------
        // Receive student's media
        // -----------------------------------------------------

        peerConnection.ontrack =
            function(event)
            {
                console.log(
                    "Received remote track from:",
                    connectionId
                );


                let video =
                    document.getElementById(
                        "video-" + connectionId
                    );


                // If video doesn't exist, create it
                if (!video)
                {
                    video =
                        document.createElement(
                            "video"
                        );

                    video.id =
                        "video-" + connectionId;

                    video.autoplay = true;
                    video.playsInline = true;

                    video.width = 300;

                    remoteVideos.appendChild(
                        video
                    );
                }


                video.srcObject =
                    event.streams[0];
            };


        // -----------------------------------------------------
        // ICE candidate
        // -----------------------------------------------------

        peerConnection.onicecandidate =
            async function(event)
            {
                if (event.candidate)
                {
                    await connection.invoke(
                        "SendIceCandidate",
                        connectionId,
                        JSON.stringify(
                            event.candidate
                        )
                    );
                }
            };


        return peerConnection;
    }


    // =========================================================
    // 7. USER JOINED
    // =========================================================

    connection.on(
        "UserJoined",
        async function(connectionId)
        {
            console.log(
                "User joined:",
                connectionId
            );


            status.innerText =
                "A student joined";


            // Create a NEW PeerConnection
            // for this particular student

            const peerConnection =
                createPeerConnection(
                    connectionId
                );


            // Store it

            peerConnections[
                connectionId
            ] =
                peerConnection;


            // Create offer

            const offer =
                await peerConnection
                    .createOffer();


            await peerConnection
                .setLocalDescription(
                    offer
                );


            // Send offer to this student

            await connection.invoke(
                "SendOffer",

                parseInt(
                    document.getElementById(
                        "lectureId"
                    ).value
                ),

                connectionId,

                JSON.stringify(offer)
            );
        }
    );


    // =========================================================
    // 8. RECEIVE OFFER
    // =========================================================

    connection.on(
        "ReceiveOffer",
        async function(
            senderConnectionId,
            offer
        )
        {
            console.log(
                "Received offer from:",
                senderConnectionId
            );


            /*
                Create PeerConnection for
                the instructor.
            */

            const peerConnection =
                createPeerConnection(
                    senderConnectionId
                );


            peerConnections[
                senderConnectionId
            ] =
                peerConnection;


            // Convert offer JSON → object

            const parsedOffer =
                JSON.parse(offer);


            // Set remote description

            await peerConnection
                .setRemoteDescription(
                    parsedOffer
                );


            // Create answer

            const answer =
                await peerConnection
                    .createAnswer();


            // Set local description

            await peerConnection
                .setLocalDescription(
                    answer
                );


            // Send answer back

            await connection.invoke(
                "SendAnswer",

                senderConnectionId,

                JSON.stringify(answer)
            );
        }
    );


    // =========================================================
    // 9. RECEIVE ANSWER
    // =========================================================

    connection.on(
        "ReceiveAnswer",
        async function(
            senderConnectionId,
            answer
        )
        {
            console.log(
                "Received answer from:",
                senderConnectionId
            );


            const peerConnection =
                peerConnections[
                    senderConnectionId
                ];


            if (!peerConnection)
            {
                console.error(
                    "PeerConnection not found:",
                    senderConnectionId
                );

                return;
            }


            const parsedAnswer =
                JSON.parse(answer);


            await peerConnection
                .setRemoteDescription(
                    parsedAnswer
                );


            status.innerText =
                "WebRTC connection established";
        }
    );


    // =========================================================
    // 10. RECEIVE ICE CANDIDATE
    // =========================================================

    connection.on(
        "ReceiveIceCandidate",
        async function(
            senderConnectionId,
            candidate
        )
        {
            console.log(
                "Received ICE candidate from:",
                senderConnectionId
            );


            const peerConnection =
                peerConnections[
                    senderConnectionId
                ];


            if (!peerConnection)
            {
                console.error(
                    "PeerConnection not found for ICE:"
                    ,
                    senderConnectionId
                );

                return;
            }


            const parsedCandidate =
                JSON.parse(candidate);


            await peerConnection
                .addIceCandidate(
                    parsedCandidate
                );
        }
    );


    // =========================================================
    // 11. STUDENT LEFT
    // =========================================================

    connection.on(
        "StudentLeft",
        function(connectionId)
        {
            console.log(
                "Student left:",
                connectionId
            );


            const peerConnection =
                peerConnections[
                    connectionId
                ];


            if (peerConnection)
            {
                peerConnection.close();

                delete peerConnections[
                    connectionId
                ];
            }


            // Remove student's video

            const video =
                document.getElementById(
                    "video-" + connectionId
                );


            if (video)
            {
                video.remove();
            }


            status.innerText =
                "Student left";
        }
    );


    // =========================================================
    // 12. JOIN BUTTON
    // =========================================================

    joinButton.onclick =
        async function()
        {
            try
            {
                status.innerText =
                    "Starting...";


                joinButton.disabled =
                    true;

                leaveButton.disabled =
                    false;


                // Start SignalR

                await connection.start();


                // Start camera

                await startCamera();


                // Get lecture ID

                const lectureId =
                    parseInt(
                        document.getElementById(
                            "lectureId"
                        ).value
                    );


                // Join lecture

                await connection.invoke(
                    "JoinLecture",
                    lectureId
                );


                status.innerText =
                    "Joined lecture";
            }
            catch(error)
            {
                console.error(error);


                status.innerText =
                    "Error: " +
                    error.message;
            }
        };


    // =========================================================
    // 13. LEAVE BUTTON
    // =========================================================

    leaveButton.onclick =
        async function()
        {
            try
            {
                const lectureId =
                    parseInt(
                        document.getElementById(
                            "lectureId"
                        ).value
                    );


                // Tell SignalR

                await connection.invoke(
                    "LeaveLecture",
                    lectureId
                );


                // Stop camera

                if(localStream)
                {
                    localStream
                        .getTracks()
                        .forEach(
                            track =>
                            {
                                track.stop();
                            }
                        );


                    localVideo.srcObject =
                        null;

                    localStream =
                        null;
                }


                // Close ALL PeerConnections

                Object
                    .values(peerConnections)
                    .forEach(
                        peerConnection =>
                        {
                            peerConnection.close();
                        }
                    );


                // Clear dictionary

                Object
                    .keys(peerConnections)
                    .forEach(
                        connectionId =>
                        {
                            delete peerConnections[
                                connectionId
                            ];
                        }
                    );


                // Clear remote videos

                remoteVideos.innerHTML =
                    "";


                // Stop SignalR

                await connection.stop();


                status.innerText =
                    "You left the meeting";


                joinButton.disabled =
                    false;

                leaveButton.disabled =
                    true;
            }
            catch(error)
            {
                console.error(error);


                status.innerText =
                    "Error while leaving: " +
                    error.message;
            }
        };

</script>