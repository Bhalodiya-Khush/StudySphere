@{
    ViewData["Title"] = "Live Lecture";

    int lectureId = ViewBag.LectureId;
    string lectureTitle = ViewBag.LectureTitle;
}

<div class="container py-4">

    <!-- =========================================================
         LECTURE HEADER
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-2">
                @lectureTitle
            </h2>

            <p class="text-muted mb-3">
                Live lecture
            </p>

            <!--
                Lecture ID is supplied by the server.
                User does not need to enter it.
            -->
            <input type="hidden"
                   id="lectureId"
                   value="@lectureId" />

            <button id="joinButton"
                    class="btn btn-success">
                🎥 Join Lecture
            </button>

            <button id="leaveButton"
                    class="btn btn-danger"
                    disabled>
                Leave Meeting
            </button>

            <button id="screenShareButton"
                    class="btn btn-outline-primary"
                    disabled>
                Share Screen
            </button>

            <p id="status"
               class="text-muted mt-3 mb-0">
                Not connected
            </p>

        </div>

    </div>


    <!-- =========================================================
         LOCAL VIDEO
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <h4 class="fw-bold mb-3">
                My Video
            </h4>

            <video id="localVideo"
                   autoplay
                   muted
                   playsinline
                   width="400"
                   class="rounded border">
            </video>

        </div>

    </div>


    <!-- =========================================================
         REMOTE VIDEOS
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <h4 class="fw-bold mb-3">
                Students / Remote Videos
            </h4>

            <div id="remoteVideos"
                 class="d-flex flex-wrap gap-3">

                <!-- Remote videos will be created using JavaScript -->

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     SIGNALR
     ============================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
</script>


<script>

    // =========================================================
    // 1. HTML ELEMENTS
    // =========================================================

    const localVideo =
        document.getElementById("localVideo");

    const remoteVideos =
        document.getElementById("remoteVideos");

    const joinButton =
        document.getElementById("joinButton");

    const leaveButton =
        document.getElementById("leaveButton");

    const screenShareButton =
        document.getElementById("screenShareButton");

    const status =
        document.getElementById("status");

    const lectureId =
        parseInt(
            document.getElementById("lectureId").value
        );


    console.log("Lecture ID:", lectureId);


    // =========================================================
    // 2. SIGNALR CONNECTION
    // =========================================================

    const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/lectureHub")
            .build();


    // =========================================================
    // 3. WEBRTC CONNECTIONS
    // =========================================================

    /*
        One instructor can have multiple students.

        Therefore:

        Student 1 → PeerConnection 1
        Student 2 → PeerConnection 2
        Student 3 → PeerConnection 3

        peerConnections stores all connections.
    */

    const peerConnections = {};


    // =========================================================
    // 4. LOCAL STREAM
    // =========================================================

    let localStream = null;
    let screenStream = null;


    // =========================================================
    // 5. START CAMERA AND MICROPHONE
    // =========================================================

    async function startCamera()
    {
        localStream =
            await navigator.mediaDevices
                .getUserMedia({
                    video: true,
                    audio: true
                });

        localVideo.srcObject =
            localStream;
    }


    // =========================================================
    // 6. CREATE PEER CONNECTION
    // =========================================================

    function createPeerConnection(connectionId)
    {
        console.log(
            "Creating PeerConnection for:",
            connectionId
        );


        const peerConnection =
            new RTCPeerConnection({

                iceServers: [
                    {
                        urls:
                            "stun:stun.l.google.com:19302"
                    }
                ]

            });


        // -----------------------------------------------------
        // Add local camera + microphone
        // -----------------------------------------------------

        if (localStream)
        {
            localStream
                .getTracks()
                .forEach(track =>
                {
                    peerConnection.addTrack(
                        track,
                        localStream
                    );
                });

            if (screenStream)
            {
                const videoSender =
                    peerConnection.getSenders()
                        .find(sender => sender.track?.kind === "video");

                if (videoSender)
                {
                    videoSender
                        .replaceTrack(screenStream.getVideoTracks()[0])
                        .catch(error => console.error(
                            "Could not replace the video track:",
                            error
                        ));
                }
            }
        }


        // -----------------------------------------------------
        // Receive remote student's media
        // -----------------------------------------------------

        peerConnection.ontrack =
            function(event)
            {
                console.log(
                    "Received remote track from:",
                    connectionId
                );


                let video =
                    document.getElementById(
                        "video-" + connectionId
                    );


                // Create video if it doesn't exist
                if (!video)
                {
                    video =
                        document.createElement(
                            "video"
                        );

                    video.id =
                        "video-" + connectionId;

                    video.autoplay = true;

                    video.playsInline = true;

                    video.width = 300;

                    video.className =
                        "rounded border";

                    remoteVideos.appendChild(
                        video
                    );
                }

                async function replaceVideoTrack(track)
                {
                    const replacements =
                        Object.values(peerConnections).map(peerConnection =>
                        {
                            const sender =
                                peerConnection.getSenders()
                                    .find(item => item.track?.kind === "video");

                            return sender ? sender.replaceTrack(track) : Promise.resolve();
                        });

                    await Promise.all(replacements);
                }

                async function stopScreenSharing(restoreCamera = true)
                {
                    if (!screenStream)
                    {
                        return;
                    }

                    const stoppedStream = screenStream;
                    screenStream = null;
                    stoppedStream.getTracks().forEach(track => track.stop());

                    const cameraTrack = localStream?.getVideoTracks()[0];
                    if (restoreCamera && cameraTrack)
                    {
                        await replaceVideoTrack(cameraTrack);
                        localVideo.srcObject = localStream;
                    }

                    screenShareButton.innerText = "Share Screen";
                }


                video.srcObject =
                    event.streams[0];
            };


        // -----------------------------------------------------
        // ICE candidate
        // -----------------------------------------------------

        peerConnection.onicecandidate =
            async function(event)
            {
                if (event.candidate)
                {
                    try
                    {
                        await connection.invoke(
                            "SendIceCandidate",

                            connectionId,

                            JSON.stringify(
                                event.candidate
                            )
                        );
                    }
                    catch(error)
                    {
                        console.error(
                            "ICE candidate error:",
                            error
                        );
                    }
                }
            };


        return peerConnection;
    }


    // =========================================================
    // 7. USER JOINED
    // =========================================================

    connection.on(
        "UserJoined",
        async function(connectionId)
        {
            console.log(
                "User joined:",
                connectionId
            );


            status.innerText =
                "A student joined";


            // Create PeerConnection
            const peerConnection =
                createPeerConnection(
                    connectionId
                );


            // Store connection
            peerConnections[
                connectionId
            ] =
                peerConnection;


            // Create offer
            const offer =
                await peerConnection
                    .createOffer();


            // Set local description
            await peerConnection
                .setLocalDescription(
                    offer
                );


            // Send offer to student
            await connection.invoke(
                "SendOffer",

                lectureId,

                connectionId,

                JSON.stringify(
                    offer
                )
            );
        }
    );


    // =========================================================
    // 8. RECEIVE OFFER
    // =========================================================

    connection.on(
        "ReceiveOffer",
        async function(
            senderConnectionId,
            offer
        )
        {
            console.log(
                "Received offer from:",
                senderConnectionId
            );


            /*
                This side creates a PeerConnection
                for the instructor.
            */

            const peerConnection =
                createPeerConnection(
                    senderConnectionId
                );


            peerConnections[
                senderConnectionId
            ] =
                peerConnection;


            // Convert JSON to object
            const parsedOffer =
                JSON.parse(offer);


            // Set remote description
            await peerConnection
                .setRemoteDescription(
                    parsedOffer
                );


            // Create answer
            const answer =
                await peerConnection
                    .createAnswer();


            // Set local description
            await peerConnection
                .setLocalDescription(
                    answer
                );


            // Send answer back
            await connection.invoke(
                "SendAnswer",

                senderConnectionId,

                JSON.stringify(
                    answer
                )
            );
        }
    );


    // =========================================================
    // 9. RECEIVE ANSWER
    // =========================================================

    connection.on(
        "ReceiveAnswer",
        async function(
            senderConnectionId,
            answer
        )
        {
            console.log(
                "Received answer from:",
                senderConnectionId
            );


            const peerConnection =
                peerConnections[
                    senderConnectionId
                ];


            if (!peerConnection)
            {
                console.error(
                    "PeerConnection not found:",
                    senderConnectionId
                );

                return;
            }


            const parsedAnswer =
                JSON.parse(answer);


            await peerConnection
                .setRemoteDescription(
                    parsedAnswer
                );


            status.innerText =
                "WebRTC connection established";
        }
    );


    // =========================================================
    // 10. RECEIVE ICE CANDIDATE
    // =========================================================

    connection.on(
        "ReceiveIceCandidate",
        async function(
            senderConnectionId,
            candidate
        )
        {
            console.log(
                "Received ICE candidate from:",
                senderConnectionId
            );


            const peerConnection =
                peerConnections[
                    senderConnectionId
                ];


            if (!peerConnection)
            {
                console.error(
                    "PeerConnection not found for ICE:",
                    senderConnectionId
                );

                return;
            }


            const parsedCandidate =
                JSON.parse(candidate);


            await peerConnection
                .addIceCandidate(
                    parsedCandidate
                );
        }
    );


    // =========================================================
    // 11. STUDENT LEFT
    // =========================================================

    connection.on(
        "StudentLeft",
        function(connectionId)
        {
            console.log(
                "Student left:",
                connectionId
            );


            const peerConnection =
                peerConnections[
                    connectionId
                ];


            if (peerConnection)
            {
                peerConnection.close();

                delete peerConnections[
                    connectionId
                ];
            }


            // Remove student's video
            const video =
                document.getElementById(
                    "video-" + connectionId
                );


            if (video)
            {
                video.remove();
            }


            status.innerText =
                "Student left";
        }
    );


    // =========================================================
    // 12. JOIN BUTTON
    // =========================================================

    joinButton.onclick =
        async function()
        {
            try
            {
                status.innerText =
                    "Starting...";


                joinButton.disabled =
                    true;

                leaveButton.disabled =
                    false;


                // -------------------------------------------------
                // Start SignalR
                // -------------------------------------------------

                await connection.start();


                console.log(
                    "SignalR connected."
                );


                // -------------------------------------------------
                // Start camera
                // -------------------------------------------------

                await startCamera();


                console.log(
                    "Camera started."
                );


                // -------------------------------------------------
                // Join lecture
                // -------------------------------------------------

                await connection.invoke(
                    "JoinLecture",
                    lectureId
                );

                screenShareButton.disabled = false;

                console.log(
                    "Joined lecture:",
                    lectureId
                );


                status.innerText =
                    "Joined lecture";
            }
            catch(error)
            {
                console.error(
                    "Join error:",
                    error
                );


                status.innerText =
                    "Error: " +
                    error.message;


                joinButton.disabled =
                    false;

                leaveButton.disabled =
                    true;
            }
        };

    screenShareButton.onclick =
        async function()
        {
            try
            {
                if (screenStream)
                {
                    await stopScreenSharing();
                    return;
                }

                screenStream =
                    await navigator.mediaDevices.getDisplayMedia({
                        video: true,
                        audio: false
                    });

                const screenTrack =
                    screenStream.getVideoTracks()[0];
                if (!screenTrack)
                {
                    await stopScreenSharing();
                    return;
                }

                await replaceVideoTrack(screenTrack);
                localVideo.srcObject = new MediaStream([
                    screenTrack,
                    ...localStream.getAudioTracks()
                ]);
                screenTrack.onended = stopScreenSharing;
                screenShareButton.innerText = "Stop Sharing";
            }
            catch(error)
            {
                status.innerText =
                    "Screen sharing error: " + error.message;
            }
        };


    // =========================================================
    // 13. LEAVE BUTTON
    // =========================================================

    leaveButton.onclick =
        async function()
        {
            try
            {
                // -------------------------------------------------
                // Tell SignalR that user left
                // -------------------------------------------------

                if (
                    connection.state ===
                    signalR.HubConnectionState.Connected
                )
                {
                    await connection.invoke(
                        "LeaveLecture",
                        lectureId
                    );
                }


                // -------------------------------------------------
                // Stop camera + microphone
                // -------------------------------------------------

                if (localStream)
                {
                    await stopScreenSharing(false);
                    localStream
                        .getTracks()
                        .forEach(track =>
                        {
                            track.stop();
                        });


                    localVideo.srcObject =
                        null;

                    localStream =
                        null;
                }


                // -------------------------------------------------
                // Close all PeerConnections
                // -------------------------------------------------

                Object
                    .values(peerConnections)
                    .forEach(
                        peerConnection =>
                        {
                            peerConnection.close();
                        }
                    );


                // -------------------------------------------------
                // Clear PeerConnections
                // -------------------------------------------------

                Object
                    .keys(peerConnections)
                    .forEach(
                        connectionId =>
                        {
                            delete peerConnections[
                                connectionId
                            ];
                        }
                    );


                // -------------------------------------------------
                // Clear remote videos
                // -------------------------------------------------

                remoteVideos.innerHTML =
                    "";


                // -------------------------------------------------
                // Stop SignalR
                // -------------------------------------------------

                if (
                    connection.state !==
                    signalR.HubConnectionState.Disconnected
                )
                {
                    await connection.stop();
                }


                status.innerText =
                    "You left the meeting";


                joinButton.disabled =
                    false;

                screenShareButton.disabled = true;
                leaveButton.disabled =
                    true;
            }
            catch(error)
            {
                console.error(
                    "Leave error:",
                    error
                );


                status.innerText =
                    "Error while leaving: " +
                    error.message;
            }
        };

</script>