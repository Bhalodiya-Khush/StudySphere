@model List<StudySphere.Models.Assignment>
@{
    var course = ViewBag.Course as StudySphere.Models.Course;
    ViewData["Title"] = "Course assignments";
}

<div class="container py-4">
    <a asp-action="CourseDetails" asp-route-id="@course?.CourseId"
       class="text-decoration-none">Back to course</a>
    <h1 class="h3 mt-3">Assignments</h1>
    <p class="text-muted">@course?.Title</p>

    @if (TempData["AssignmentMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">There are no published assignments for this course.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var assignment in Model)
            {
                var submission = assignment.Submissions.FirstOrDefault();
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">@assignment.Title</h2>
                        <div class="small text-muted">
                            Due @assignment.DueAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            · @assignment.MaxMarks marks
                        </div>
                        @if (submission?.MarksAwarded is not null)
                        {
                            <div class="small text-success mt-1">
                                Graded: @submission.MarksAwarded / @assignment.MaxMarks
                            </div>
                        }
                        else if (submission is not null)
                        {
                            <div class="small text-primary mt-1">Submitted; awaiting review</div>
                        }
                    </div>
                    <a asp-action="SubmitAssignment"
                       asp-route-assignmentId="@assignment.AssignmentId"
                       class="btn btn-outline-primary">
                        @(submission is null ? "Submit work" : "View submission")
                    </a>
                </div>
            }
        </div>
    }
</div>
