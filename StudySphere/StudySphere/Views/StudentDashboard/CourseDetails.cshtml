@model StudySphere.Models.Course

@{
    ViewData["Title"] = Model.Title;
    var materialsForLearning = ViewBag.Materials as List<StudySphere.Models.Material>
        ?? new List<StudySphere.Models.Material>();
    var completedMaterialIdsForLearning = ViewBag.CompletedMaterialIds
        as HashSet<int> ?? new HashSet<int>();
    var nextMaterial = materialsForLearning.FirstOrDefault(material =>
        !completedMaterialIdsForLearning.Contains(material.MaterialId))
        ?? materialsForLearning.FirstOrDefault();
    var completedMaterialIds =
        ViewBag.CompletedMaterialIds as HashSet<int> ?? new HashSet<int>();
}

<div class="container py-4">

    <div class="row g-4">

        <!-- Course Image -->

        <div class="col-md-5">

            <img src="@Model.ThumbnailUrl"
                 alt="@Model.Title"
                 class="img-fluid rounded shadow-sm w-100">

        </div>


        <!-- Course Information -->

        <div class="col-md-7">

            <span class="badge bg-success mb-3">
                @Model.Category
            </span>

            <h1 class="fw-bold">
                @Model.Title
            </h1>

            <p class="text-muted mt-3">
                @Model.Description
            </p>

            <p class="text-muted">
                Instructor: @(Model.Instructor?.User?.FullName ?? "StudySphere Instructor")
            </p>

            @if (TempData["EnrollmentMessage"] is string enrollmentMessage)
            {
                <div class="alert alert-info" role="status">@enrollmentMessage</div>
            }
            @if (TempData["ProgressMessage"] is string progressMessage)
            {
                <div class="alert alert-success" role="status">@progressMessage</div>
            }

            <hr>

            <div class="d-flex gap-2">
                @if (ViewBag.IsEnrolled == true)
                {
                    @if (nextMaterial is not null)
                    {
                        <a href="#material-@nextMaterial.MaterialId" class="btn btn-success">
                            Continue learning
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success" disabled>
                            Learning materials coming soon
                        </button>
                    }
                    <a asp-controller="StudentDashboard"
                       asp-action="Assignments"
                       asp-route-courseId="@Model.CourseId"
                       class="btn btn-outline-primary">
                        View assignments
                    </a>
                    <a asp-controller="StudentDashboard"
                       asp-action="Quizzes"
                       asp-route-courseId="@Model.CourseId"
                       class="btn btn-outline-primary">
                        View quizzes
                    </a>
                }
                else if (User.IsInRole("Student"))
                {
                    <form asp-controller="StudentDashboard"
                          asp-action="Enroll"
                          method="post">
                        <input type="hidden" name="courseId" value="@Model.CourseId" />
                        <button type="submit" class="btn btn-success">Enroll in course</button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-success">
                        Sign in to enroll
                    </a>
                }
                @if (ViewBag.CertificateAvailable == true)
                {
                    <a asp-action="Certificate"
                       asp-route-courseId="@Model.CourseId"
                       class="btn btn-outline-success">
                        View certificate
                    </a>
                }

                <a asp-controller="StudentDashboard"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>


    <!-- =========================================================
     COURSE CONTENT
     ========================================================= -->

    <div class="mt-5">

        <h3 class="fw-bold mb-3">
            Course Content
        </h3>

        <p class="text-muted mb-4">
            @if (ViewBag.IsEnrolled == true)
            {
                <span>Your course videos, documents and live lectures appear below.</span>
            }
            else
            {
                <span>Enroll in this course to unlock learning materials and live lectures.</span>
            }
        </p>

        @if (ViewBag.IsEnrolled == true)
        {
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-semibold">Course progress</span>
                    <span>@ViewBag.CourseProgress%</span>
                </div>
                <div class="progress" role="progressbar"
                     aria-valuenow="@ViewBag.CourseProgress" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @ViewBag.CourseProgress%"></div>
                </div>
            </div>

            var materials = materialsForLearning;
            if (materials is { Count: > 0 })
            {
                <div class="card border-0 shadow-sm mb-4" id="learning-materials">
                    <div class="card-body">
                        <h4 class="fw-bold mb-3">Learning Materials</h4>
                        @foreach (var material in materials)
                        {
                            <div class="border-bottom py-3" id="material-@material.MaterialId">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            @if (material.MaterialType == "Video")
                                            {
                                                <span class="badge bg-primary">▶ Video</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">📄 PDF</span>
                                            }
                                            <h5 class="mb-0 fw-semibold">@material.Title</h5>
                                            @if (material.DurationInMinutes.HasValue)
                                            {
                                                <span class="text-muted small">(@material.DurationInMinutes min)</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(material.Description))
                                        {
                                            <p class="text-muted small mb-0">@material.Description</p>
                                        }
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        @if (material.MaterialType == "Video")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#videoPlayer-@material.MaterialId"
                                                    aria-expanded="false"
                                                    aria-controls="videoPlayer-@material.MaterialId">
                                                Watch Video
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-controller="StudentDashboard"
                                               asp-action="ViewMaterial"
                                               asp-route-id="@material.MaterialId"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-info">
                                                View PDF
                                            </a>
                                        }

                                        <a asp-controller="StudentDashboard"
                                           asp-action="DownloadMaterial"
                                           asp-route-id="@material.MaterialId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Download
                                        </a>

                                        @if (completedMaterialIds.Contains(material.MaterialId))
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else
                                        {
                                            <form asp-controller="StudentDashboard"
                                                  asp-action="CompleteLesson"
                                                  method="post"
                                                  class="d-inline">
                                                <input type="hidden" name="materialId" value="@material.MaterialId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    Mark complete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>

                                @if (material.MaterialType == "Video")
                                {
                                    <div class="collapse mt-3" id="videoPlayer-@material.MaterialId">
                                        <div class="card card-body bg-dark p-2 rounded">
                                            <video controls
                                                   playsinline
                                                   preload="metadata"
                                                   class="w-100 rounded"
                                                   style="max-height: 480px; background-color: #000;"
                                                   src="@Url.Action("ViewMaterial", "StudentDashboard", new { id = material.MaterialId })">
                                                Your browser does not support HTML5 video streaming.
                                            </video>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">No learning materials have been published yet.</div>
            }
        }


        <!-- =====================================================
         LIVE LECTURES
         ===================================================== -->

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between
                    align-items-center mb-3">

                    <div>

                        <h4 class="fw-bold mb-1">
                            🎥 Live Lectures
                        </h4>

                        <p class="text-muted small mb-0">
                            Join live sessions conducted by your instructor.
                        </p>

                    </div>

                </div>


                @{
                    var liveLectures =
                        ViewBag.LiveLectures
                        as List<StudySphere.Models.LiveLecture>;
                }


                @if (liveLectures != null && liveLectures.Any())
                {
                    foreach (var lecture in liveLectures)
                    {
                        <div class="border rounded p-3 mb-3">

                            <div class="row align-items-center">

                                <!-- Lecture Information -->

                                <div class="col-md-8">

                                    <h5 class="fw-bold mb-1">
                                        @lecture.Title
                                    </h5>

                                    <p class="text-muted small mb-2">
                                        @lecture.Description
                                    </p>

                                    <div class="small">

                                        <strong>
                                            Start:
                                        </strong>

                                        @lecture.StartTime.ToString(
                                            "dd MMM yyyy, hh:mm tt"
                                        )

                                    </div>

                                    <div class="small">

                                        <strong>
                                            End:
                                        </strong>

                                        @lecture.EndTime.ToString(
                                            "dd MMM yyyy, hh:mm tt"
                                        )

                                    </div>

                                </div>


                                <!-- Lecture Action -->

                                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                                    @if (lecture.Status == "Live")
                                    {
                                        <a asp-controller="LiveLecture"
                                           asp-action="Room"
                                           asp-route-lectureId="@lecture.LiveLectureId"
                                           class="btn btn-success">

                                            🎥 Join Live Lecture

                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary"
                                                disabled>

                                            Lecture Not Live

                                        </button>
                                    }

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">

                        <div class="fs-1 mb-2">
                            🎥
                        </div>

                        <h5 class="fw-bold">
                            No Live Lectures
                        </h5>

                        <p class="text-muted mb-0">
                            No live lectures are currently scheduled
                            for this course.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>