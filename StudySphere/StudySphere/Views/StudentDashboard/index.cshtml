@model StudySphere.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "My Learning";
}

<div class="dashboard-shell">
    <section class="dashboard-welcome">
        <div>
            <span class="eyebrow">YOUR LEARNING SPACE</span>
            <h1>Welcome back, @Model.StudentName</h1>
            <p>Learn. Grow. Succeed. Pick up where you left off or discover your next course.</p>
        </div>
        <div class="welcome-actions">
            <a asp-action="AllCourses" class="btn btn-brand">Explore courses</a>
            <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-brand">
                Notifications
            </a>
        </div>
    </section>

    <section class="row g-4 mb-4" aria-label="Learning summary">
        <div class="col-sm-6 col-xl-3">
            <article class="summary-card">
                <span class="summary-icon">▣</span>
                <div><p>Enrolled courses</p><strong>@Model.EnrolledCourses.Count</strong></div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-3">
            <article class="summary-card">
                <span class="summary-icon">✓</span>
                <div><p>Completed courses</p><strong>@Model.CompletedCourses</strong></div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-3">
            <article class="summary-card">
                <span class="summary-icon">◷</span>
                <div><p>Upcoming assignments</p><strong>@Model.UpcomingAssignments</strong></div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-3">
            <article class="summary-card summary-progress">
                <span class="summary-icon">↗</span>
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="mb-1">Overall progress</p>
                        <strong>@Model.OverallProgress.ToString("0.#")%</strong>
                    </div>
                    <div class="progress" role="progressbar"
                         aria-label="Overall course progress"
                         aria-valuenow="@Model.OverallProgress.ToString("0.#")"
                         aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @Model.OverallProgress.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-section-heading">
            <div>
                <span class="eyebrow">KEEP YOUR MOMENTUM</span>
                <h2>Continue learning</h2>
            </div>
            <a asp-action="MyCourses" class="section-link">All my courses <span aria-hidden="true">→</span></a>
        </div>

        @if (Model.EnrolledCourses.Count > 0)
        {
            <div class="row g-4">
                @foreach (var course in Model.EnrolledCourses)
                {
                    var progress = Model.CourseProgress.GetValueOrDefault(course.CourseId);
                    ViewData["IsEnrolledCourse"] = true;
                    <div class="col-sm-6 col-xl-4">
                        <article class="learning-course-card">
                            <partial name="_CourseCard" model="course" />
                            <div class="learning-course-progress">
                                <div class="d-flex justify-content-between">
                                    <span>Course progress</span><strong>@progress.ToString("0.#")%</strong>
                                </div>
                                <div class="progress" role="progressbar"
                                     aria-label="@course.Title progress"
                                     aria-valuenow="@progress.ToString("0.#")"
                                     aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" style="width: @progress.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <div class="course-quicklinks">
                                    <a asp-action="Assignments" asp-route-courseId="@course.CourseId">Assignments</a>
                                    <a asp-action="Quizzes" asp-route-courseId="@course.CourseId">Quizzes</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon">✦</span>
                <h3>Your learning journey starts here</h3>
                <p>Browse approved courses and enroll to unlock lessons, assignments, and quizzes.</p>
                <a asp-action="AllCourses" class="btn btn-brand">Find a course</a>
            </div>
        }
    </section>

    <section class="dashboard-section">
        <div class="dashboard-section-heading">
            <div>
                <span class="eyebrow">FIND YOUR NEXT SKILL</span>
                <h2>Explore courses</h2>
            </div>
            <a asp-action="AllCourses" class="section-link">Browse all <span aria-hidden="true">→</span></a>
        </div>

        @if (Model.AllCourses.Count > 0)
        {
            <div class="row g-4">
                @foreach (var course in Model.AllCourses.Take(6))
                {
                    ViewData["IsEnrolledCourse"] = Model.CourseProgress.ContainsKey(course.CourseId);
                    <div class="col-sm-6 col-xl-4">
                        <partial name="_CourseCard" model="course" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state compact-empty">
                <h3>No approved courses yet</h3>
                <p>Check back later for new courses from our instructors.</p>
            </div>
        }
    </section>

    @if (Model.Categories.Count > 0)
    {
        <section class="dashboard-section">
            <div class="dashboard-section-heading">
                <div>
                    <span class="eyebrow">BROWSE BY INTEREST</span>
                    <h2>Course categories</h2>
                </div>
            </div>
            <div class="category-chip-list">
                @foreach (var category in Model.Categories)
                {
                    <a asp-action="CategoryCourses"
                       asp-route-category="@category"
                       class="category-chip">@category <span aria-hidden="true">→</span></a>
                }
            </div>
        </section>
    }
</div>
