@model List<StudySphere.Models.Course>

@{
    ViewData["Title"] = "All Courses";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Explore Courses</h2>

        <p class="text-muted">
            Explore all courses available on StudySphere.
        </p>
    </div>

    <form asp-controller="StudentDashboard" asp-action="AllCourses" method="get"
          class="card card-body border-0 shadow-sm mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="search" class="form-label">Search</label>
                <input id="search" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Course title or keyword" />
            </div>
            <div class="col-md-2">
                <label for="category" class="form-label">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var item in (IEnumerable<string>)ViewBag.Categories)
                    {
                        <option value="@item" selected="@(ViewBag.Category == item)">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="level" class="form-label">Level</label>
                <select id="level" name="level" class="form-select">
                    <option value="">Any level</option>
                    @foreach (var item in new[] { "Beginner", "Intermediate", "Advanced" })
                    {
                        <option value="@item" selected="@(ViewBag.Level == item)">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label for="minimumPrice" class="form-label">Min price</label>
                <input id="minimumPrice" name="minimumPrice" type="number" min="0" step="0.01"
                       value="@ViewBag.MinimumPrice" class="form-control" />
            </div>
            <div class="col-md-1">
                <label for="maximumPrice" class="form-label">Max price</label>
                <input id="maximumPrice" name="maximumPrice" type="number" min="0" step="0.01"
                       value="@ViewBag.MaximumPrice" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Apply filters</button>
            </div>
        </div>
    </form>

    <div class="row g-4">

        @if (Model.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">No courses match the selected filters.</div>
            </div>
        }
        @foreach (var course in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <partial name="_CourseCard"
                         model="course" />

            </div>
        }

    </div>

</div>