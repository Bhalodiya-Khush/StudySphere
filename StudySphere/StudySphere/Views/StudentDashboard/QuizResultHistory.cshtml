@model List<StudySphere.Models.QuizAttempt>
@{
    var quiz = ViewBag.Quiz as StudySphere.Models.Quiz;
    ViewData["Title"] = "Quiz history";
}

<div class="container py-4">
    <a asp-action="Quizzes" asp-route-courseId="@quiz?.CourseId"
       class="text-decoration-none">Back to quizzes</a>
    <h1 class="h3 mt-3">@quiz?.Title history</h1>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No attempts have been submitted yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr><th>Attempt</th><th>Submitted</th><th>Score</th></tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>@attempt.AttemptNumber</td>
                            <td>@attempt.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@attempt.Score / @attempt.MaxScore</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
