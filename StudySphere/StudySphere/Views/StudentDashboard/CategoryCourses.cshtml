@model List<StudySphere.Models.Course>

@{
    ViewData["Title"] = ViewBag.Category + " Courses";
}

<div class="container py-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            @ViewBag.Category Courses
        </h2>

        <p class="text-muted">
            Explore courses in the @ViewBag.Category category.
        </p>

    </div>


    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No courses available in this category.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <partial name="_CourseCard"
                             model="course" />

                </div>
            }

        </div>
    }

</div>