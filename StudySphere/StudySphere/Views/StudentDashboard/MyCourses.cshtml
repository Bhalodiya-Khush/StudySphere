@model List<StudySphere.Models.Course>

@{
    ViewData["Title"] = "My Courses";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Courses</h2>

        <p class="text-muted">
            Courses you are currently pursuing.
        </p>
    </div>


    <div class="row g-4">

        @foreach (var course in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <partial name="_CourseCard"
                         model="course" />

            </div>
        }

    </div>

</div>