@model StudySphere.Models.Course

<article class="card border-0 shadow-sm h-100 course-card student-course-card">
    @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
    {
        <img src="@Model.ThumbnailUrl" alt="@Model.Title course thumbnail" class="card-img-top course-thumbnail" />
    }
    else
    {
        <div class="course-thumbnail course-thumbnail-placeholder" role="img" aria-label="@Model.Title course cover">
            <span>StudySphere</span>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <span class="badge course-category-badge">@(Model.Category ?? "Course")</span>
            <span class="course-level">@(Model.Level ?? "All levels")</span>
        </div>
        <h3 class="card-title course-card-title">@Model.Title</h3>
        <p class="card-text text-muted small course-card-description">@Model.Description</p>
        <div class="course-card-meta">
            <span>@(Model.Price == 0 ? "Free" : Model.Price.ToString("C"))</span>
        </div>
        <div class="mt-auto pt-3">
            @if (User.IsInRole("Student") && ViewData["IsEnrolledCourse"] is true)
            {
                <a asp-controller="StudentDashboard" asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-brand w-100">
                    Continue this course
                </a>
                <div class="course-card-actions">
                    <a asp-controller="StudentDashboard" asp-action="Assignments" asp-route-courseId="@Model.CourseId">Assignments</a>
                    <a asp-controller="StudentDashboard" asp-action="Quizzes" asp-route-courseId="@Model.CourseId">Quizzes</a>
                </div>
            }
            else if (User.IsInRole("Instructor") || ViewData["IsInstructor"] is true)
            {
                <a asp-controller="InstructorDashboard" asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-brand w-100">
                    Manage this course
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="StudentDashboard" asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-brand w-100">
                    View course
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   asp-route-returnUrl="@Url.Action("CourseDetails", "StudentDashboard", new { id = Model.CourseId })"
                   class="btn btn-brand w-100">
                    Sign in to view course
                </a>
            }
        </div>
    </div>
</article>
