@model StudySphere.Models.Course

<article class="card border-0 shadow-sm h-100 course-card instructor-course-card">
    @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
    {
        <img src="@Model.ThumbnailUrl" alt="@Model.Title course thumbnail" class="card-img-top course-thumbnail" />
    }
    else
    {
        <div class="course-thumbnail course-thumbnail-placeholder" role="img" aria-label="@Model.Title course cover">
            <span>StudySphere</span>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <span class="badge course-category-badge">@(Model.Category ?? "Course")</span>
            <span class="badge course-status-badge">@Model.Status</span>
        </div>
        <h3 class="card-title course-card-title">@Model.Title</h3>
        <p class="card-text text-muted small course-card-description">@Model.Description</p>
        <div class="course-card-meta">
            <span>@(Model.Level ?? "All levels")</span>
            <span>@(Model.Price == 0 ? "Free" : Model.Price.ToString("C"))</span>
        </div>
        <div class="mt-auto pt-3">
            <a asp-controller="InstructorDashboard" asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-brand w-100">
                Open course workspace
            </a>
            <div class="course-card-actions instructor-course-actions">
                <a asp-controller="InstructorDashboard" asp-action="Students" asp-route-courseId="@Model.CourseId">Students & progress</a>
                <a asp-controller="InstructorDashboard" asp-action="Materials" asp-route-courseId="@Model.CourseId">Materials</a>
                <a asp-controller="InstructorDashboard" asp-action="Assignments" asp-route-courseId="@Model.CourseId">Assignments</a>
                <a asp-controller="InstructorDashboard" asp-action="Quizzes" asp-route-courseId="@Model.CourseId">Quizzes</a>
                <a asp-controller="InstructorDashboard" asp-action="LiveLectures" asp-route-courseId="@Model.CourseId">Live lectures</a>
            </div>
        </div>
    </div>
</article>
