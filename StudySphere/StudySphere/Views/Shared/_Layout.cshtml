<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="StudySphere — Learn. Grow. Succeed." />
    <title>@ViewData["Title"] - StudySphere</title>
    <link rel="icon" type="image/png" href="~/images/StudySphereIcon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/studysphere-ui.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <nav class="app-navbar" aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index" class="app-brand">
                <img src="~/images/StudySphereIcon.png" alt="" />
                <span><strong>StudySphere</strong><small>Learn · Grow · Succeed</small></span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="app-nav-links">
                    @if (User.IsInRole("Student"))
                    {
                        <a asp-controller="StudentDashboard" asp-action="Index">My learning</a>
                        <a asp-controller="StudentDashboard" asp-action="AllCourses">Explore courses</a>
                    }
                    else if (User.IsInRole("Instructor"))
                    {
                        <a asp-controller="InstructorDashboard" asp-action="Index">Dashboard</a>
                        <a asp-controller="InstructorDashboard" asp-action="Courses">My courses</a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
                        <a asp-controller="AdminDashboard" asp-action="CourseRequests">Course requests</a>
                    }
                    <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                </div>
            }

            <div class="app-nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="Index" class="app-profile-link">
                        <span class="app-avatar">@(User.Identity.Name?.FirstOrDefault() ?? 'U')</span>
                        <span class="profile-email">@User.Identity.Name</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-brand btn-sm" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-brand">Sign in</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="nav-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobileNavigation">
                        <span></span><span></span><span></span>
                    </button>
                }
            </div>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div id="mobileNavigation" class="mobile-navigation">
                @if (User.IsInRole("Student"))
                {
                    <a asp-controller="StudentDashboard" asp-action="Index">My learning</a>
                    <a asp-controller="StudentDashboard" asp-action="AllCourses">Explore courses</a>
                }
                else if (User.IsInRole("Instructor"))
                {
                    <a asp-controller="InstructorDashboard" asp-action="Index">Dashboard</a>
                    <a asp-controller="InstructorDashboard" asp-action="Courses">My courses</a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
                    <a asp-controller="AdminDashboard" asp-action="CourseRequests">Course requests</a>
                }
                <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                <a asp-controller="Profile" asp-action="Index">My profile</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-brand btn-sm mt-2" type="submit">Sign out</button>
                </form>
            </div>
        }
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <a asp-controller="Home" asp-action="Index" class="app-brand footer-brand">
            <img src="~/images/StudySphereIcon.png" alt="" />
            <span><strong>StudySphere</strong><small>Learn · Grow · Succeed</small></span>
        </a>
        <div class="footer-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            }
        </div>
        <small>© @DateTime.Now.Year StudySphere</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/studysphere-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
