@model StudySphere.Models.Instructor

<article class="admin-user-card">
    <div class="admin-user-identity">
        <span class="admin-user-avatar instructor-user-avatar">@(Model.User.FullName.FirstOrDefault().ToString().ToUpperInvariant())</span>
        <div>
            <h2>@Model.User.FullName</h2>
            <p>@Model.User.Email</p>
        </div>
    </div>
    <div class="admin-user-facts">
        <span>@(Model.ProfessionalTitle ?? "Instructor")</span>
        <span>@(Model.AreaOfExpertise ?? "Expertise not provided")</span>
        <span class="user-status @(Model.User.IsActive ? "is-active" : "is-inactive")">
            @(Model.User.IsActive ? "Active" : "Awaiting approval")
        </span>
    </div>
    <div class="admin-user-actions">
        <a asp-controller="AdminDashboard" asp-action="ViewInstructor" asp-route-id="@Model.InstructorId" class="btn btn-outline-brand btn-sm">View profile</a>
        @if (Model.User.IsActive)
        {
            <form asp-controller="AdminDashboard" asp-action="SetInstructorActive" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.InstructorId" />
                <input type="hidden" name="isActive" value="false" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
            </form>
        }
        else
        {
            <form asp-controller="AdminDashboard" asp-action="ApproveInstructor" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.InstructorId" />
                <button type="submit" class="btn btn-sm btn-brand">Approve / activate</button>
            </form>
        }
    </div>
</article>
