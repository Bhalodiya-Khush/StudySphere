@model StudySphere.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main class="home-page">

    <!-- ================= HERO SECTION ================= -->
    <section class="hero-section">

        <div class="hero-content reveal">

            <span class="hero-badge">
                <span class="badge-dot"></span>
                Learn. Grow. Succeed.
            </span>

            <h1>
                Build Your
                <span>Future</span>
                Through Learning.
            </h1>

            <p class="hero-description">
                Explore practical courses, improve your skills,
                track your progress, and learn at your own pace
                with StudySphere.
            </p>

            <div class="hero-buttons">

                <a href="/Account/Login" class="btn-primary">
                    Start Learning
                    <span>→</span>
                </a>

                <a href="#courses" class="btn-secondary">
                    Explore Courses
                </a>

            </div>

            <div class="hero-stats" aria-label="StudySphere community">
                <div class="stat-item">
                    <strong>@Model.CourseCount.ToString("N0")</strong>
                    <span>Published courses</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <strong>@Model.InstructorCount.ToString("N0")</strong>
                    <span>Instructors</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <strong>@Model.StudentCount.ToString("N0")</strong>
                    <span>Learners</span>
                </div>
            </div>

        </div>


        <!-- HERO VISUAL -->
        <div class="hero-visual reveal">

            <div class="hero-circle circle-one"></div>
            <div class="hero-circle circle-two"></div>

            <div class="student-image-wrapper">
                <img src="~/images/student-hero.png"
                     alt="Student learning online"
                     class="student-image" />
            </div>

        </div>

    </section>


    <!-- ================= CATEGORIES ================= -->
    <section class="categories-section" id="courses">

        <div class="section-heading reveal">

            <div>
                <span class="section-label">EXPLORE</span>

                <h2>
                    Learn Skills That
                    <span>Move You Forward.</span>
                </h2>
            </div>

            <p>
                Discover courses designed to help you
                build practical and career-ready skills.
            </p>

        </div>


        @if (Model.Categories.Count > 0)
        {
            <div class="category-grid">
                @foreach (var category in Model.Categories)
                {
                    <a asp-controller="StudentDashboard"
                       asp-action="CategoryCourses"
                       asp-route-category="@category.Name"
                       class="category-card reveal">
                        <div class="category-icon" aria-hidden="true">✦</div>
                        <div class="category-info">
                            <h3>@category.Name</h3>
                            <p>@category.CourseCount course@(category.CourseCount == 1 ? "" : "s")</p>
                        </div>
                        <span class="category-arrow" aria-hidden="true">→</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="empty-courses">New learning categories are on their way.</p>
        }


        <div class="view-all-wrapper reveal">

            <a asp-controller="StudentDashboard"
               asp-action="AllCourses"
               class="view-all-btn">
                View All Courses
                <span>→</span>
            </a>

        </div>

    </section>

    <section class="home-courses-section" aria-labelledby="featured-courses-title">
        <div class="section-heading reveal">
            <div>
                <span class="section-label">LEARN SOMETHING NEW</span>
                <h2 id="featured-courses-title">Featured <span>Courses.</span></h2>
            </div>
            <p>Explore courses published by our instructors. Sign in to open a course and start learning.</p>
        </div>

        @if (Model.Courses.Count > 0)
        {
            <div class="row g-4">
                @foreach (var course in Model.Courses)
                {
                    <div class="col-sm-6 col-xl-4 reveal">
                        <partial name="_CourseCard" model="course" />
                    </div>
                }
            </div>
            <div class="view-all-wrapper reveal">
                <a asp-controller="StudentDashboard"
                   asp-action="AllCourses"
                   class="view-all-btn">
                    Browse all courses <span aria-hidden="true">→</span>
                </a>
            </div>
        }
        else
        {
            <div class="empty-courses">
                <h3>Courses are on the way</h3>
                <p>Approved courses will appear here as instructors publish them.</p>
            </div>
        }
    </section>


    <!-- ================= WHY STUDYSPHERE ================= -->
    <section class="features-section">

        <div class="features-intro reveal">

            <span class="section-label">WHY STUDYSPHERE</span>

            <h2>
                Everything You Need
                <span>To Keep Learning.</span>
            </h2>

            <p>
                StudySphere brings your learning experience
                together in one simple and focused platform.
            </p>

            <a href="/Account/Login" class="feature-cta">
                Get Started →
            </a>

        </div>


        <div class="features-grid">

            <div class="feature-card reveal">

                <div class="feature-number">01</div>

                <div class="feature-icon">
                    ◉
                </div>

                <h3>Learn at Your Pace</h3>

                <p>
                    Learn whenever you want and continue
                    your courses from where you stopped.
                </p>

            </div>


            <div class="feature-card reveal">

                <div class="feature-number">02</div>

                <div class="feature-icon">
                    ✓
                </div>

                <h3>Track Your Progress</h3>

                <p>
                    Monitor your learning journey and
                    understand how far you've progressed.
                </p>

            </div>


            <div class="feature-card reveal">

                <div class="feature-number">03</div>

                <div class="feature-icon">
                    ★
                </div>

                <h3>Practical Learning</h3>

                <p>
                    Focus on useful skills and knowledge
                    that can be applied in real projects.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= CTA ================= -->
    <section class="cta-section reveal">

        <div class="cta-content">

            <span class="section-label">START YOUR JOURNEY</span>

            <h2>
                Ready to Start
                <span>Learning?</span>
            </h2>

            <p>
                Create your account and take the next step
                toward your learning goals.
            </p>

            <a href="/Account/Login" class="cta-button">
                Start Learning
                <span>→</span>
            </a>

        </div>

    </section>

</main>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}