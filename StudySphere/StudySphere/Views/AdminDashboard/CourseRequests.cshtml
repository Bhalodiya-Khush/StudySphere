@model IEnumerable<StudySphere.Models.Course>

@{
ViewData["Title"] = "Course Requests";
}

<div class="container-fluid py-4">

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Course Requests
        </h2>

        <p class="text-muted mb-0">
            Review courses submitted by instructors for approval.
        </p>
    </div>

    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>


<!-- Pending Course Count -->
<div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">

    <div>
        <strong>
            Pending Requests
        </strong>

        <span class="ms-2">
            @Model.Count() course(s) waiting for approval.
        </span>
    </div>

    <span class="badge bg-warning text-dark fs-6">
        @Model.Count()
    </span>

</div>


<!-- Course Requests -->
<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">
            Pending Courses
        </h5>
    </div>


    <div class="card-body p-0">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>

                            <th>
                                Course
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Level
                            </th>

                            <th>
                                Price
                            </th>

                            <th>
                                Submitted
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var course in Model)
                        {
                            <tr>

                                <!-- Course -->
                                <td>
                                    <div class="d-flex align-items-center">

                                        @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                        {
                                            <img src="@course.ThumbnailUrl"
                                                 alt="@course.Title"
                                                 width="55"
                                                 height="40"
                                                 class="rounded me-3"
                                                 style="object-fit: cover;">
                                        }

                                        <div>
                                            <div class="fw-semibold">
                                                @course.Title
                                            </div>

                                            <small class="text-muted">
                                                Course ID: @course.CourseId
                                            </small>
                                        </div>

                                    </div>
                                </td>


                                <!-- Category -->
                                <td>
                                    @course.Category
                                </td>


                                <!-- Level -->
                                <td>
                                    @course.Level
                                </td>


                                <!-- Price -->
                                <td>
                                    ₹@course.Price
                                </td>


                                <!-- Date -->
                                <td>
                                    @course.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>


                                <!-- Status -->
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @course.Status
                                    </span>
                                </td>


                                <!-- Action -->
                                <td class="text-end">

                                    <a asp-controller="AdminDashboard"
                                       asp-action="ReviewCourse"
                                       asp-route-id="@course.CourseId"
                                       class="btn btn-primary btn-sm">
                                        Review
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- Empty State -->

            <div class="text-center py-5">

                <div class="mb-3">
                    <span class="fs-1">
                        ✓
                    </span>
                </div>

                <h5 class="fw-bold">
                    No Pending Requests
                </h5>

                <p class="text-muted mb-0">
                    There are currently no courses waiting for approval.
                </p>

            </div>
        }

    </div>

</div>

</div>
