@model StudySphere.Models.Instructor

@{
    ViewData["Title"] = "View Instructor";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Instructor Details
            </h2>

            <p class="text-muted mb-0">
                View instructor information and created courses.
            </p>
        </div>

        <a asp-controller="AdminDashboard"
           asp-action="Instructors"
           class="btn btn-outline-secondary">
            Back to Instructors
        </a>

    </div>


    <!-- Instructor Information -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                Instructor Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- Instructor ID -->
                <div class="col-md-6 mb-3">

                    <small class="text-muted d-block">
                        Instructor ID
                    </small>

                    <strong>
                        #@Model.InstructorId
                    </strong>

                </div>


                <!-- Professional Title -->
                <div class="col-md-6 mb-3">

                    <small class="text-muted d-block">
                        Professional Title
                    </small>

                    <strong>
                        @Model.ProfessionalTitle
                    </strong>

                </div>


                <!-- Area of Expertise -->
                <div class="col-md-6 mb-3">

                    <small class="text-muted d-block">
                        Area of Expertise
                    </small>

                    <strong>
                        @Model.AreaOfExpertise
                    </strong>

                </div>


                <!-- Qualification -->
                <div class="col-md-6 mb-3">

                    <small class="text-muted d-block">
                        Qualification
                    </small>

                    <strong>
                        @Model.Qualification
                    </strong>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <small class="text-muted d-block">
                        Status
                    </small>

                    <span class="badge bg-success">
                        Active
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Instructor Courses -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Created Courses
                    </h5>

                    <small class="text-muted">
                        Courses created by this instructor.
                    </small>
                </div>

                <span class="badge bg-primary fs-6">
                    @(ViewBag.Courses?.Count ?? 0)
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (ViewBag.Courses != null &&
                 ViewBag.Courses.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Course</th>
                                <th>Category</th>
                                <th>Level</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var course in ViewBag.Courses)
                            {
                                <tr>

                                    <!-- Course -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                                            {
                                                <img src="@course.ThumbnailUrl"
                                                     alt="@course.Title"
                                                     width="60"
                                                     height="45"
                                                     class="rounded me-3"
                                                     style="object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                                     style="width:60px; height:45px;">

                                                    <small class="text-muted">
                                                        N/A
                                                    </small>

                                                </div>
                                            }

                                            <div>

                                                <div class="fw-semibold">
                                                    @course.Title
                                                </div>

                                                <small class="text-muted">
                                                    ID: @course.CourseId
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Category -->
                                    <td>
                                        @course.Category
                                    </td>


                                    <!-- Level -->
                                    <td>
                                        @course.Level
                                    </td>


                                    <!-- Price -->
                                    <td>
                                        ₹@course.Price
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (course.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (course.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (course.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @course.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->
                                    <td class="text-end">

                                        <a asp-controller="AdminDashboard"
                                           asp-action="ReviewCourse"
                                           asp-route-id="@course.CourseId"
                                           class="btn btn-outline-primary btn-sm">
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="fw-bold">
                        No Courses Found
                    </h5>

                    <p class="text-muted mb-0">
                        This instructor has not created any courses yet.
                    </p>

                </div>
            }

        </div>

    </div>

</div>
