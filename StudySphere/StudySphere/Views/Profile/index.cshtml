@model StudySphere.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">My profile</h1>
            <p class="text-muted mb-0">Manage your account and professional information.</p>
        </div>
        <span class="badge text-bg-primary fs-6">@Model.Role</span>
    </div>

    @if (TempData["ProfileMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage"
                             alt="Profile picture for @Model.FullName"
                             class="rounded-circle mb-3"
                             width="144"
                             height="144"
                             style="object-fit: cover;">
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 144px; height: 144px;">
                            <i class="fa-solid fa-user fa-4x text-secondary" aria-hidden="true"></i>
                        </div>
                    }
                    <h2 class="h4 fw-bold mb-1">@Model.FullName</h2>
                    <p class="text-muted mb-0">@Model.Email</p>
                    @if (Model.Role == "Student")
                    {
                        <div class="row g-3 mt-4 text-start">
                            <div class="col-4">
                                <div class="rounded bg-light p-3 h-100">
                                    <div class="fw-bold">@Model.EnrolledCourses</div>
                                    <small class="text-muted">Enrolled</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="rounded bg-light p-3 h-100">
                                    <div class="fw-bold">@Model.CompletedCourses</div>
                                    <small class="text-muted">Completed</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="rounded bg-light p-3 h-100">
                                    <div class="fw-bold">@Model.Certificates</div>
                                    <small class="text-muted">Certificates</small>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.Role == "Instructor")
                    {
                        <div class="mt-4 text-start">
                            <div class="fw-semibold">@Model.ProfessionalTitle</div>
                            <div class="text-muted small">@Model.AreaOfExpertise</div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-lg-8">
            <section class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h2 class="h5 fw-bold mb-0">Account information</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Index" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Full name</label>
                                <input asp-for="FullName" class="form-control" autocomplete="name">
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" readonly>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" autocomplete="tel">
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            @if (Model.Role is "Student" or "Instructor")
                            {
                                <div class="col-md-6">
                                    <label asp-for="ProfilePicture" class="form-label">Profile picture</label>
                                    <input asp-for="ProfilePicture"
                                           class="form-control"
                                           type="file"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                                    <div class="form-text">JPG, PNG, or WebP; maximum 5 MB.</div>
                                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                                </div>
                            }

                            @if (Model.Role is "Student" or "Instructor")
                            {
                                <div class="col-12">
                                    <label asp-for="Bio" class="form-label">About me</label>
                                    <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                                    <span asp-validation-for="Bio" class="text-danger small"></span>
                                </div>
                            }

                            @if (Model.Role == "Instructor")
                            {
                                <div class="col-md-6">
                                    <label asp-for="ProfessionalTitle" class="form-label">Professional title</label>
                                    <input asp-for="ProfessionalTitle" class="form-control">
                                    <span asp-validation-for="ProfessionalTitle" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AreaOfExpertise" class="form-label">Area of expertise</label>
                                    <input asp-for="AreaOfExpertise" class="form-control">
                                    <span asp-validation-for="AreaOfExpertise" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Qualification" class="form-label">Qualification</label>
                                    <input asp-for="Qualification" class="form-control">
                                    <span asp-validation-for="Qualification" class="text-danger small"></span>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary">
                                Save profile
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
