@using StudySphere.Models

@{
    ViewData["Title"] = "My Courses";

    var courses = ViewBag.Courses as List<Course>;
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">My Courses</h2>
            <p class="text-muted mb-0">
                Manage the courses you have created.
            </p>
        </div>

        <a asp-controller="InstructorDashboard"
           asp-action="CreateCourse"
           class="btn btn-success">
            + Create Course
        </a>

    </div>


    <!-- Courses -->
    <div class="row g-4">

        @if (courses != null && courses.Any())
        {
            foreach (var course in courses)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                    <partial name="_CourseCard" model="course" />

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">

                        <h5 class="fw-bold">
                            No Courses Found
                        </h5>

                        <p class="text-muted">
                            You have not created any courses yet.
                        </p>

                        <a asp-controller="InstructorDashboard"
                           asp-action="CreateCourse"
                           class="btn btn-success">
                            Create Your First Course
                        </a>

                    </div>
                </div>

            </div>
        }

    </div>

</div>