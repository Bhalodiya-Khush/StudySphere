@model List<StudySphere.Models.AssignmentSubmission>
@{
    var assignment = ViewBag.Assignment as StudySphere.Models.Assignment;
    ViewData["Title"] = "Assignment submissions";
}

<div class="container py-4">
    <a asp-action="Assignments" asp-route-courseId="@assignment?.CourseId"
       class="text-decoration-none">Back to assignments</a>
    <h1 class="h3 mt-3">@assignment?.Title</h1>
    <p class="text-muted">Submissions · Maximum @assignment?.MaxMarks marks</p>

    @if (TempData["AssignmentError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (TempData["AssignmentMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No students have submitted this assignment yet.</div>
    }
    else
    {
        @foreach (var submission in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                        <div>
                            <h2 class="h5 mb-1">@submission.Student.User.FullName</h2>
                            <div class="small text-muted">
                                Submitted @submission.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                        <a asp-action="DownloadSubmission"
                           asp-route-submissionId="@submission.SubmissionId"
                           class="btn btn-outline-secondary">Download work</a>
                    </div>

                    @if (submission.MarksAwarded.HasValue)
                    {
                        <p class="mb-2">
                            Current grade: <strong>@submission.MarksAwarded / @assignment?.MaxMarks</strong>
                        </p>
                    }
                    <form asp-action="EvaluateAssignmentSubmission" method="post"
                          class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="submissionId" value="@submission.SubmissionId" />
                        <div class="col-sm-3">
                            <label for="marks-@submission.SubmissionId" class="form-label">Marks</label>
                            <input id="marks-@submission.SubmissionId" name="marks" type="number"
                                   min="0" max="@assignment?.MaxMarks" step="0.01"
                                   value="@submission.MarksAwarded" class="form-control" required />
                        </div>
                        <div class="col-sm-7">
                            <label for="feedback-@submission.SubmissionId" class="form-label">Feedback</label>
                            <input id="feedback-@submission.SubmissionId" name="feedback"
                                   value="@submission.Feedback" maxlength="4000" class="form-control" />
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-primary w-100">Save grade</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>
