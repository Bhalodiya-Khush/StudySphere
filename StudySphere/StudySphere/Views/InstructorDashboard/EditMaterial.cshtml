@model StudySphere.Models.Material

@{
    ViewData["Title"] = "Edit Material";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">

        <a asp-controller="InstructorDashboard"
           asp-action="Materials"
           asp-route-courseId="@Model.CourseId"
           class="text-decoration-none text-muted">
            ← Back to Materials
        </a>

        <h2 class="fw-bold mt-3 mb-1">
            Edit Material
        </h2>

        <p class="text-muted">
            Update the material information.
        </p>

    </div>


    <!-- Form -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-controller="InstructorDashboard"
                  asp-action="EditMaterial"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Hidden IDs -->
                <input type="hidden"
                       asp-for="MaterialId" />

                <input type="hidden"
                       asp-for="CourseId" />


                <!-- Title -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label fw-semibold">
                        Material Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter material title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter material description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Material Type -->
                <div class="mb-3">

                    <label asp-for="MaterialType"
                           class="form-label fw-semibold">
                        Material Type
                    </label>

                    <select asp-for="MaterialType"
                            class="form-select">

                        <option value="Video">
                            Video
                        </option>

                        <option value="PDF">
                            PDF
                        </option>

                    </select>

                    <span asp-validation-for="MaterialType"
                          class="text-danger">
                    </span>

                </div>


                <!-- File URL -->
                <div class="mb-3">

                    <label asp-for="FileUrl"
                           class="form-label fw-semibold">
                        File URL
                    </label>

                    <input asp-for="FileUrl"
                           class="form-control"
                           placeholder="/materials/course/file.mp4" />

                    <div class="form-text">
                        Actual file upload will be connected later.
                    </div>

                    <span asp-validation-for="FileUrl"
                          class="text-danger">
                    </span>

                </div>


                <!-- Duration -->
                <div class="mb-3">

                    <label asp-for="DurationInMinutes"
                           class="form-label fw-semibold">
                        Duration (minutes)
                    </label>

                    <input asp-for="DurationInMinutes"
                           type="number"
                           class="form-control"
                           placeholder="Example: 30" />

                    <div class="form-text">
                        Mainly used for videos. Leave empty for PDF.
                    </div>

                    <span asp-validation-for="DurationInMinutes"
                          class="text-danger">
                    </span>

                </div>


                <!-- Display Order -->
                <div class="mb-3">

                    <label asp-for="DisplayOrder"
                           class="form-label fw-semibold">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger">
                    </span>

                </div>


                <!-- Published -->
                <div class="form-check mb-4">

                    <input asp-for="IsPublished"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsPublished"
                           class="form-check-label">
                        Publish this material
                    </label>

                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Save Changes
                    </button>

                    <a asp-controller="InstructorDashboard"
                       asp-action="Materials"
                       asp-route-courseId="@Model.CourseId"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}