@using StudySphere.Models

@{
    ViewData["Title"] = "Course Materials";

    var course = ViewBag.Course as Course;
    var materials = ViewBag.Materials as List<Material>;
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">

        <a asp-controller="InstructorDashboard"
           asp-action="CourseDetails"
           asp-route-id="@course?.CourseId"
           class="text-decoration-none text-muted">
            ← Back to Course
        </a>

        <div class="d-flex justify-content-between align-items-center mt-3">

            <div>
                <h2 class="fw-bold mb-1">
                    Course Materials
                </h2>

                <p class="text-muted mb-0">
                    @course?.Title
                </p>
            </div>

            <a asp-controller="InstructorDashboard"
               asp-action="CreateMaterial"
               asp-route-courseId="@course?.CourseId"
               class="btn btn-success">
                + Add Material
            </a>

        </div>

    </div>


    <!-- Materials List -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (materials != null && materials.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var material in materials)
                            {
                                <tr>

                                    <td>
                                        @material.DisplayOrder
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @material.Title
                                        </div>

                                        @if (!string.IsNullOrEmpty(material.Description))
                                        {
                                            <small class="text-muted">
                                                @material.Description
                                            </small>
                                        }
                                    </td>

                                    <td>

                                        @if (material.MaterialType == "Video")
                                        {
                                            <span class="badge bg-primary">
                                                Video
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                PDF
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @if (material.DurationInMinutes.HasValue)
                                        {
                                            <span>@material.DurationInMinutes min</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>

                                        @if (material.IsPublished)
                                        {
                                            <span class="badge bg-success">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="InstructorDashboard"
                                           asp-action="EditMaterial"
                                           asp-route-id="@material.MaterialId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-controller="InstructorDashboard"
                                              asp-action="DeleteMaterial"
                                              asp-route-id="@material.MaterialId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this material?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="fw-bold">
                        No Materials Found
                    </h5>

                    <p class="text-muted">
                        Add videos or PDF materials to this course.
                    </p>

                    <a asp-controller="InstructorDashboard"
                       asp-action="CreateMaterial"
                       asp-route-courseId="@course?.CourseId"
                       class="btn btn-success">
                        + Add Material
                    </a>

                </div>
            }

        </div>

    </div>

</div>