@using StudySphere.Models

@{
    ViewData["Title"] = "Instructor Dashboard";

    var instructor = ViewBag.Instructor as Instructor;
    var courses = ViewBag.Courses as List<Course>;
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">
            Welcome, @(instructor?.User?.FullName ?? "Instructor")
        </h2>

        <p class="text-muted">
            Create engaging courses and support your students. Learn · Grow · Succeed.
        </p>
    </div>

    <div class="dashboard-quicklinks mb-4">
        <a asp-controller="InstructorDashboard" asp-action="CreateCourse" class="dashboard-quicklink">
            <span>＋</span><strong>Create a course</strong><small>Start building a new course</small>
        </a>
        <a asp-controller="InstructorDashboard" asp-action="Courses" class="dashboard-quicklink">
            <span>▣</span><strong>Manage courses</strong><small>Edit courses and learning content</small>
        </a>
        <a asp-controller="Notifications" asp-action="Index" class="dashboard-quicklink">
            <span>♧</span><strong>Notifications</strong><small>Reviews and student activity</small>
        </a>
    </div>


    <!-- Instructor Information -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h4 class="fw-bold mb-1">
                        @instructor?.ProfessionalTitle
                    </h4>

                    <p class="text-muted mb-1">
                        @instructor?.AreaOfExpertise
                    </p>

                    <p class="small text-muted mb-0">
                        @instructor?.Qualification
                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <a asp-controller="InstructorDashboard"
                       asp-action="Courses"
                       class="btn btn-success">
                        Manage Courses
                    </a>

                </div>

            </div>

        </div>
    </div>


    <!-- Statistics -->
    <div class="row g-3 mb-5">

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        My Courses
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalCourses
                    </h3>
                </div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Students
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalStudents
                    </h3>
                </div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Materials
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalMaterials
                    </h3>
                </div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Live Lectures
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.UpcomingLectures
                    </h3>
                </div>
            </div>
        </div>

    </div>


    <!-- My Courses Heading -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h4 class="fw-bold mb-1">
                My Courses
            </h4>

            <p class="text-muted mb-0">
                Courses created by you
            </p>
        </div>

        <a asp-controller="InstructorDashboard"
           asp-action="Courses"
           class="btn btn-outline-success">
            View All
        </a>

    </div>


    <!-- Responsive Course Cards -->
    <div class="row g-4">

        @if (courses != null)
        {
            foreach (var course in courses)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <partial name="_CourseCard" model="course" />
                </div>
            }
        }

    </div>

</div>