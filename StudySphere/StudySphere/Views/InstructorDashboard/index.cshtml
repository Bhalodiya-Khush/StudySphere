@using StudySphere.Models

@{
    ViewData["Title"] = "Instructor Dashboard";

    var instructor = ViewBag.Instructor as Instructor;
    var courses = ViewBag.Courses as List<Course>;
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">
            Welcome, Instructor 👋
        </h2>

        <p class="text-muted">
            Manage your courses, students and learning content.
        </p>
    </div>


    <!-- Instructor Information -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h4 class="fw-bold mb-1">
                        @instructor?.ProfessionalTitle
                    </h4>

                    <p class="text-muted mb-1">
                        @instructor?.AreaOfExpertise
                    </p>

                    <p class="small text-muted mb-0">
                        @instructor?.Qualification
                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <a asp-controller="InstructorDashboard"
                       asp-action="Courses"
                       class="btn btn-success">
                        Manage Courses
                    </a>

                </div>

            </div>

        </div>
    </div>


    <!-- Statistics -->
    <div class="row g-3 mb-5">

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        My Courses
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalCourses
                    </h3>
                </div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Students
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalStudents
                    </h3>
                </div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Materials
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalMaterials
                    </h3>
                </div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">
                        Live Lectures
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.UpcomingLectures
                    </h3>
                </div>
            </div>
        </div>

    </div>


    <!-- My Courses Heading -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h4 class="fw-bold mb-1">
                My Courses
            </h4>

            <p class="text-muted mb-0">
                Courses created by you
            </p>
        </div>

        <a asp-controller="InstructorDashboard"
           asp-action="Courses"
           class="btn btn-outline-success">
            View All
        </a>

    </div>


    <!-- Horizontal Course Cards -->
    <div class="d-flex overflow-auto gap-3 pb-3">

        @if (courses != null)
        {
            foreach (var course in courses)
            {
                <div style="min-width: 280px; max-width: 280px;">
                    <partial name="_CourseCard" model="course" />
                </div>
            }
        }

    </div>

</div>