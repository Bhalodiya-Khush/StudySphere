@using StudySphere.Models

@{
    ViewData["Title"] = "Schedule Live Lecture";

    var course = ViewBag.Course as Course;
}

<div class="container py-4">

    <!-- Back Button -->
    <div class="mb-3">
        <a asp-action="LiveLectures"
           asp-route-courseId="@course?.CourseId"
           class="btn btn-outline-secondary">
            ← Back to Live Lectures
        </a>
    </div>

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Schedule Live Lecture</h2>

        <p class="text-muted mb-0">
            Schedule a live lecture for:
            <strong>@course?.Title</strong>
        </p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="CreateLiveLecture" method="post">

                <!-- Course ID -->
                <input type="hidden"
                       name="CourseId"
                       value="@course?.CourseId" />

                <!-- Instructor ID -->
                <input type="hidden"
                       name="InstructorId"
                       value="1" />

                <!-- Title -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Lecture Title
                    </label>

                    <input type="text"
                           name="Title"
                           class="form-control"
                           placeholder="Enter lecture title"
                           required />
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea name="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter lecture description"></textarea>
                </div>

                <!-- Start Time -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Start Time
                    </label>

                    <input type="datetime-local"
                           name="StartTime"
                           class="form-control"
                           required />
                </div>

                <!-- End Time -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        End Time
                    </label>

                    <input type="datetime-local"
                           name="EndTime"
                           class="form-control"
                           required />
                </div>

                <!-- Meeting URL -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Meeting URL
                    </label>

                    <input type="url"
                           name="MeetingUrl"
                           class="form-control"
                           placeholder="https://meet.google.com/..." />
                </div>

                <!-- Status -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <select name="Status"
                            class="form-select">

                        <option value="Scheduled">
                            Scheduled
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                        <option value="Cancelled">
                            Cancelled
                        </option>

                    </select>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Schedule Lecture
                    </button>

                    <a asp-action="LiveLectures"
                       asp-route-courseId="@course?.CourseId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>