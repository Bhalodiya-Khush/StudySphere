@model List<StudySphere.Models.QuizAttempt>
@{
    var quiz = ViewBag.Quiz as StudySphere.Models.Quiz;
    ViewData["Title"] = "Quiz attempts";
}

<div class="container py-4">
    <a asp-action="Quizzes" asp-route-courseId="@quiz?.CourseId"
       class="text-decoration-none">Back to quizzes</a>
    <h1 class="h3 mt-3">@quiz?.Title results</h1>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No students have attempted this quiz yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr><th>Student</th><th>Attempt</th><th>Submitted</th><th>Score</th></tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>@attempt.Student.User.FullName</td>
                            <td>@attempt.AttemptNumber</td>
                            <td>@attempt.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td><strong>@attempt.Score / @attempt.MaxScore</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
