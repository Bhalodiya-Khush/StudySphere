@model StudySphere.Models.Material

@{
    ViewData["Title"] = "Add Material";

    var course = ViewBag.Course as StudySphere.Models.Course;
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">

        <a asp-controller="InstructorDashboard"
           asp-action="Materials"
           asp-route-courseId="@course?.CourseId"
           class="text-decoration-none text-muted">
            ← Back to Materials
        </a>

        <h2 class="fw-bold mt-3 mb-1">
            Add Material
        </h2>

        <p class="text-muted">
            Add a video or PDF to <strong>@course?.Title</strong>.
        </p>

    </div>


    <!-- Form -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-controller="InstructorDashboard"
                  asp-action="CreateMaterial"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden"
                       asp-for="CourseId"
                       value="@course?.CourseId" />


                <!-- Title -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label fw-semibold">
                        Material Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter material title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter material description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Material Type -->
                <div class="mb-3">

                    <label asp-for="MaterialType"
                           class="form-label fw-semibold">
                        Material Type
                    </label>

                    <select asp-for="MaterialType"
                            class="form-select">

                        <option value="">
                            Select Material Type
                        </option>

                        <option value="Video">
                            Video
                        </option>

                        <option value="PDF">
                            PDF
                        </option>

                        <option value="Document">
                            Document
                        </option>
                    </select>

                    <span asp-validation-for="MaterialType"
                          class="text-danger">
                    </span>

                </div>


                <!-- File -->
                <div class="mb-3">

                    <label for="upload"
                           class="form-label fw-semibold">
                        Upload file
                    </label>

                    <input id="upload"
                           name="upload"
                           type="file"
                           class="form-control"
                           accept=".mp4,.webm,.mov,.pdf,.doc,.docx,.ppt,.pptx,.txt"
                           required />

                    <div class="form-text">
                        Videos: MP4, WebM or MOV. Documents: PDF, Word,
                        PowerPoint or text files. Maximum size: 500 MB.
                    </div>

                    <span class="text-danger"
                          data-valmsg-for="upload">
                    </span>

                </div>


                <!-- Duration -->
                <div class="mb-3">

                    <label asp-for="DurationInMinutes"
                           class="form-label fw-semibold">
                        Duration (minutes)
                    </label>

                    <input asp-for="DurationInMinutes"
                           type="number"
                           class="form-control"
                           placeholder="Example: 30" />

                    <div class="form-text">
                        Mainly required for videos. Leave empty for PDF.
                    </div>

                    <span asp-validation-for="DurationInMinutes"
                          class="text-danger">
                    </span>

                </div>


                <!-- Display Order -->
                <div class="mb-3">

                    <label asp-for="DisplayOrder"
                           class="form-label fw-semibold">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control"
                           value="1" />

                    <span asp-validation-for="DisplayOrder"
                          class="text-danger">
                    </span>

                </div>


                <!-- Published -->
                <div class="form-check mb-4">

                    <input asp-for="IsPublished"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsPublished"
                           class="form-check-label">
                        Publish this material
                    </label>

                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Add Material
                    </button>

                    <a asp-controller="InstructorDashboard"
                       asp-action="Materials"
                       asp-route-courseId="@course?.CourseId"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}