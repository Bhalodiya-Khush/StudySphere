@model StudySphere.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <a asp-controller="InstructorDashboard"
           asp-action="CourseDetails"
           asp-route-id="@Model.CourseId"
           class="text-decoration-none text-muted">
            ← Back to Course
        </a>

        <h2 class="fw-bold mt-3 mb-1">
            Edit Course
        </h2>

        <p class="text-muted">
            Update your course information.
        </p>
    </div>


    <!-- Edit Form -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-controller="InstructorDashboard"
                  asp-action="EditCourse"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden"
                       asp-for="CourseId" />

                <input type="hidden"
                       asp-for="InstructorId" />

                <input type="hidden"
                       asp-for="Status" />

                <input type="hidden"
                       asp-for="ThumbnailUrl" />

                <!-- Title -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label fw-semibold">
                        Course Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter course title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Enter course description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Category + Level -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Category"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Example: Web Development" />

                        <span asp-validation-for="Category"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Level"
                               class="form-label fw-semibold">
                            Level
                        </label>

                        <select asp-for="Level"
                                class="form-select">

                            <option value="">
                                Select Level
                            </option>

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Advanced">
                                Advanced
                            </option>

                        </select>

                        <span asp-validation-for="Level"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Thumbnail -->
                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Course Thumbnail
                    </label>

                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <div class="mb-2">
                            <label class="small text-muted d-block mb-1">Current Thumbnail:</label>
                            <img src="@Model.ThumbnailUrl"
                                 alt="@Model.Title"
                                 class="rounded border shadow-sm"
                                 style="max-width: 260px; max-height: 160px; object-fit: cover;" />
                        </div>
                    }

                    <input type="file"
                           name="thumbnailFile"
                           id="editThumbnailFileInput"
                           class="form-control"
                           accept="image/*" />
                    <div class="form-text">
                        Choose a new image (.jpg, .jpeg, .png, .webp) to update the thumbnail in App_Data, or leave empty to keep current image.
                    </div>

                    <div id="newThumbnailPreviewContainer" class="mt-2 d-none">
                        <label class="small text-muted d-block mb-1">New Image Preview:</label>
                        <img id="newThumbnailPreview"
                             src="#"
                             alt="New thumbnail preview"
                             class="rounded border shadow-sm"
                             style="max-width: 260px; max-height: 160px; object-fit: cover;" />
                    </div>

                </div>


                <!-- Price -->
                <div class="mb-4">

                    <label asp-for="Price"
                           class="form-label fw-semibold">
                        Price (₹)
                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="Enter course price" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>

                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Save Changes
                    </button>

                    <a asp-controller="InstructorDashboard"
                       asp-action="CourseDetails"
                       asp-route-id="@Model.CourseId"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('editThumbnailFileInput')?.addEventListener('change', function (e) {
            const file = e.target.files?.[0];
            const previewContainer = document.getElementById('newThumbnailPreviewContainer');
            const previewImg = document.getElementById('newThumbnailPreview');
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    previewImg.src = event.target.result;
                    previewContainer.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                previewContainer.classList.add('d-none');
                previewImg.src = '#';
            }
        });
    </script>
}