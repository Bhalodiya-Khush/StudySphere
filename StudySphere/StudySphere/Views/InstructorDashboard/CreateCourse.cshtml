@using StudySphere.Models

@{
    ViewData["Title"] = "Create Course";

    var instructor = ViewBag.Instructor as Instructor;
}

<div class="container py-4">

    <!-- Back Button -->
    <div class="mb-3">
        <a asp-action="Courses"
           class="btn btn-outline-secondary">
            ← Back to Courses
        </a>
    </div>

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Create New Course</h2>

        <p class="text-muted mb-0">
            Create a new course for your students.
        </p>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="CreateCourse" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- Instructor ID -->
                <input type="hidden"
                       name="InstructorId"
                       value="@instructor?.InstructorId" />

                <!-- Course Title -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Course Title
                    </label>

                    <input type="text"
                           name="Title"
                           class="form-control"
                           placeholder="Enter course title"
                           maxlength="150"
                           required />
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea name="Description"
                              class="form-control"
                              rows="5"
                              maxlength="2000"
                              placeholder="Enter course description"
                              required></textarea>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Category
                    </label>

                    <input type="text"
                           name="Category"
                           class="form-control"
                           placeholder="Example: Web Development" />
                </div>

                <!-- Level -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Level
                    </label>

                    <select name="Level"
                            class="form-select">

                        <option value="">
                            Select Level
                        </option>

                        <option value="Beginner">
                            Beginner
                        </option>

                        <option value="Intermediate">
                            Intermediate
                        </option>

                        <option value="Advanced">
                            Advanced
                        </option>

                    </select>
                </div>

                <!-- Course Thumbnail Image -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Course Thumbnail Image
                    </label>

                    <input type="file"
                           name="thumbnailFile"
                           id="thumbnailFileInput"
                           class="form-control"
                           accept="image/*" />
                    <div class="form-text">
                        Choose a thumbnail image (.jpg, .jpeg, .png, .webp) stored securely in App_Data.
                    </div>

                    <div id="thumbnailPreviewContainer" class="mt-2 d-none">
                        <label class="small text-muted d-block mb-1">Preview:</label>
                        <img id="thumbnailPreview"
                             src="#"
                             alt="Thumbnail preview"
                             class="rounded border shadow-sm"
                             style="max-width: 260px; max-height: 160px; object-fit: cover;" />
                    </div>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Price
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">₹</span>

                        <input type="number"
                               name="Price"
                               class="form-control"
                               min="0"
                               step="0.01"
                               placeholder="Enter course price"
                               required />
                    </div>
                </div>

                <!-- Status -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <select name="Status"
                            class="form-select">

                        <option value="Draft">
                            Draft
                        </option>

                        <option value="Published">
                            Published
                        </option>

                    </select>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Create Course
                    </button>

                    <a asp-action="Courses"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('thumbnailFileInput')?.addEventListener('change', function (e) {
            const file = e.target.files?.[0];
            const previewContainer = document.getElementById('thumbnailPreviewContainer');
            const previewImg = document.getElementById('thumbnailPreview');
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    previewImg.src = event.target.result;
                    previewContainer.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                previewContainer.classList.add('d-none');
                previewImg.src = '#';
            }
        });
    </script>
}